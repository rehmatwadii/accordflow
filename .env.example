APP_ENV=demo
# SQLite is a convenient single-process local demo. Docker uses PostgreSQL.
DATABASE_URL=sqlite:///./data/lcverify.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set locally, never commit actual credentials. Seed generates a random demo password if blank.
DEMO_PASSWORD=
POSTGRES_PASSWORD=
STORAGE_PATH=./data/documents
OCR_SPACE_API_KEY=
