    {
      "name": "Login as analyst",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"analyst@lcverify.demo\", \"password\": \"{{demo_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status 200', () => pm.response.to.have.status(200));",
              "pm.test('Correlation ID present', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.match(/^LCV-REQ-/));",
              "pm.environment.set('access_token', pm.response.json().access_token);"
